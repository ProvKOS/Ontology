    "baseIris" : [ "http://www.w3.org/1999/02/22-rdf-syntax-ns", "https://w3id.org/def/ProvKOS", "http://www.w3.org/2008/05/skos-xl", "http://www.w3.org/2000/01/rdf-schema", "http://www.w3.org/ns/prov", "http://www.w3.org/2001/XMLSchema", "http://www.w3.org/2004/02/skos/core" ],
    "title" : {
      "en" : "ProvKOS: An Application Profile for Documenting Provenance in Knowledge Organization Systems"
    },
    "iri" : "https://w3id.org/def/ProvKOS",
    "version" : "1.2",
    "author" : [ "Inkyung Choi", "Jessica Yi-Yun Cheng" ],
    "comments" : {
      "en" : "ProvKOS extends SKOS and PROV-O to represent the provenance of editorial activities in Knowledge Organization Systems (KOS): typed change activities, warrant structures, and the relationships among entities, activities, agents, and warrants. Revised in response to peer review (2026): class renamed to ProvKOS:ClassNumber; domain of ProvKOS:hasLabel broadened to prov:Entity; explicit PROV-O sub-property alignments; example individuals moved to separate data files. Version 1.2: the global axioms declaring skos:Concept and skos:ConceptScheme as subclasses of ProvKOS:Warrant were removed; warrant-hood is now typed by role through the ranges of ProvKOS:wasWarrantedBy and ProvKOS:cite, so that only resources actually participating as warrants are inferred to be ProvKOS:Warrant instances."
    },
