<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <owl:ObjectProperty rdf:about="https://w3id.org/def/ProvKOS#cite">
    <rdfs:domain rdf:resource="https://w3id.org/def/ProvKOS#Warrant"/>
    <rdfs:range rdf:resource="https://w3id.org/def/ProvKOS#Warrant"/>
    <rdfs:label xml:lang="en">cite</rdfs:label>
    <skos:definition xml:lang="en">A Warrant cites another Warrant, enabling the construction of warrant chains across heterogeneous evidence types (e.g., a Document citing a ConceptScheme that cites Literature).</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/def/ProvKOS#documentDate">
    <rdfs:domain rdf:resource="https://w3id.org/def/ProvKOS#Document"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="en">documentDate</rdfs:label>
    <skos:definition xml:lang="en">The date of an editorial document serving as a warrant.</skos:definition>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Organization">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/def/ProvKOS#wasDeprecatedBy">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasInvalidatedBy"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/def/ProvKOS#ClassNumber"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">wasDeprecatedBy</rdfs:label>
    <skos:definition xml:lang="en">The existing class number is deprecated, becoming 'unassigned'. Specific to classification systems in which class numbers persist as reusable containers.</skos:definition>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://w3id.org/def/ProvKOS">
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o-20130430"/>
    <dcterms:creator>Inkyung Choi</dcterms:creator>
    <dcterms:creator>Jessica Yi-Yun Cheng</dcterms:creator>
    <dcterms:title xml:lang="en">ProvKOS: An Application Profile for Documenting Provenance in Knowledge Organization Systems</dcterms:title>
    <owl:versionInfo>1.1</owl:versionInfo>
    <rdfs:comment xml:lang="en">ProvKOS extends SKOS and PROV-O to represent the provenance of editorial activities in Knowledge Organization Systems (KOS): typed change activities, warrant structures, and the relationships among entities, activities, agents, and warrants. Revised in response to peer review (2026): class renamed to ProvKOS:ClassNumber; domain of ProvKOS:hasLabel broadened to prov:Entity; explicit PROV-O sub-property alignments; example individuals moved to separate data files.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme">
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/ProvKOS#Warrant"/>
    <skos:definition xml:lang="en">Within the scope of this application profile, any SKOS concept scheme can serve as a warrant for editorial decision making (e.g., ICD-11 or a national authority file supporting a change).</skos:definition>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/def/ProvKOS#wasWarrantedBy">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasInfluencedBy"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:range rdf:resource="https://w3id.org/def/ProvKOS#Warrant"/>
    <rdfs:label xml:lang="en">wasWarrantedBy</rdfs:label>
    <skos:definition xml:lang="en">The Activity was performed based on an editorial Warrant.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/def/ProvKOS#hasLabel">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"/>
    <rdfs:label xml:lang="en">hasLabel</rdfs:label>
    <skos:definition xml:lang="en">A KOS entity (e.g., a class number in a classification system, or an authority record in a compiled vocabulary) has one or more associated human-readable labels. Preferred and alternative labels can be distinguished using skosxl:prefLabel and skosxl:altLabel for tracking changes to all types of labels.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/def/ProvKOS#Expansion">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">Expansion</rdfs:label>
    <skos:definition xml:lang="en">An expansion is when a concept is extended and the class number moves down to the narrower hierarchy.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/def/ProvKOS#Literature">
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/ProvKOS#Warrant"/>
    <rdfs:label xml:lang="en">Literature</rdfs:label>
    <skos:definition xml:lang="en">Citable literature providing evidence warranted for editorial decision making.</skos:definition>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#invalidated"/>
  <owl:Class rdf:about="https://w3id.org/def/ProvKOS#Relocation">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">Relocation</rdfs:label>
    <skos:definition xml:lang="en">A relocation is moving a concept from a class number to another class number; this movement is outside of the hierarchical tree.</skos:definition>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme">
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/def/ProvKOS#wasAuthorizedBy">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/def/ProvKOS#ClassNumber"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">wasAuthorizedBy</rdfs:label>
    <skos:definition xml:lang="en">An 'unassigned' class number is being used to represent a concept. Specific to classification systems in which class numbers persist as reusable containers.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/def/ProvKOS#Replacement">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">Replacement</rdfs:label>
    <skos:definition xml:lang="en">A replacement is having a label replaced with another label.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#SoftwareAgent">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Person">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/def/ProvKOS#Truncation">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">Truncation</rdfs:label>
    <skos:altLabel xml:lang="en">Discontinuation</skos:altLabel>
    <skos:definition xml:lang="en">A truncation is having a concept generalized, thus the class number moves up to the broader hierarchy.</skos:definition>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith"/>
  <owl:AnnotationProperty rdf:about="https://w3id.org/def/ProvKOS#documentURI">
    <rdfs:label xml:lang="en">documentURI</rdfs:label>
    <skos:definition xml:lang="en">A dereferenceable URI at which an editorial document serving as a warrant is available.</skos:definition>
  </owl:AnnotationProperty>
  <owl:DatatypeProperty rdf:about="http://www.w3.org/2008/05/skos-xl#literalForm">
    <rdfs:domain rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">literalForm</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#endedAtTime"/>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#generated"/>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasRevisionOf"/>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#startedAtTime"/>
  <owl:Class rdf:about="https://w3id.org/def/ProvKOS#ClassNumber">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Class Number</rdfs:label>
    <skos:definition xml:lang="en">ClassNumber is a numeric or alphanumeric notation to represent a concept. A concept is defined as a unit of thought, specific ideas or meanings established within a KOS. ClassNumber is assignable to classify information resources. An instance of ClassNumber may be named with a URI.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/ProvKOS#Warrant"/>
    <skos:definition xml:lang="en">Within the scope of this application profile, any SKOS concept can serve as a warrant for editorial decision making (e.g., a concept in an external vocabulary such as Homosaurus supporting a label change).</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/2008/05/skos-xl#Label">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/def/ProvKOS#ClassNumber"/>
    <rdfs:label xml:lang="en">Label</rdfs:label>
    <skos:definition xml:lang="en">The class skosxl:Label is a special class of lexical entities. An instance of the class skosxl:Label is a resource and may be named with a URI. An instance of the class skosxl:Label has a single literal form. (from SKOS-XL)</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/def/ProvKOS#Warrant">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">Warrant</rdfs:label>
    <skos:definition xml:lang="en">Any identifiable sources providing evidence warranted for editorial decision making.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/def/ProvKOS#Document">
    <rdfs:subClassOf rdf:resource="https://w3id.org/def/ProvKOS#Warrant"/>
    <rdfs:label xml:lang="en">Document</rdfs:label>
    <skos:definition xml:lang="en">Documents to record editorial process which include proposals of changes, discussions of proposals, and suggested changes and their impacts.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
</rdf:RDF>
